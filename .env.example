# Copy to .env and fill in real values. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=dumb
# APP_ORIGIN is the canonical origin; AUTH_URL is derived from it at runtime and
# must equal APP_ORIGIN. The reverse proxy must overwrite Host/X-Forwarded-*.
APP_ORIGIN=dumb
SESSION_SECRET=dumb
REGISTRATION_TICKET_SECRET=dumb
OAUTH_CLIENT_ID=dumb
OAUTH_CLIENT_SECRET=dumb
TMDB_ACCESS_TOKEN=dumb
# TRUSTED_PROXIES names the trusted edge that fronts the app. That edge MUST
# overwrite the client address (`header_up X-Forwarded-For {remote_host}`) and
# MUST NOT forward a client-supplied X-Real-IP. The app trusts only a valid
# left-most X-Forwarded-For and falls back to one shared `unknown` bucket.
TRUSTED_PROXIES=127.0.0.1
# DEMO_LOGIN=1 enables the demo login only when NODE_ENV is not production.
DEMO_LOGIN=0
LOG_LEVEL=info
